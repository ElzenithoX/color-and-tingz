{
  "name": "color-and-tingz",
  "productName": "color&tingz",
  "version": "0.1.0",
  "description": "An offline colour toolkit: converter, image palettes, gradients.",
  "author": "Elzenitho",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web --open /web.html",
    "build": "tsc --noEmit && vite build",
    "build:web": "vite build --mode web",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "color-name-list": "^14.51.0",
    "culori": "^4.0.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "electron@44.4.5": true
  }
}
